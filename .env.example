# ============================================
# School ERP — Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.
# For Docker Compose: place .env in the project root.

# ---- Database ----
POSTGRES_USER=school_erp_user
POSTGRES_PASSWORD=school_erp_pass_2024
POSTGRES_DB=school_erp
# Used by backend directly (auto-constructed in docker-compose)
DATABASE_URL="postgresql://school_erp_user:school_erp_pass_2024@localhost:5432/school_erp"

# ---- JWT (CHANGE THESE IN PRODUCTION!) ----
JWT_SECRET="generate-a-long-random-string-here"
JWT_REFRESH_SECRET="generate-another-long-random-string-here"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ---- Report Card ----
REPORT_CARD_SECRET="your-report-card-signing-secret"

# ---- Server ----
PORT=3000
NODE_ENV=production
FRONTEND_URL=http://localhost

# ---- File Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mother Teresa Foundation School <noreply@mtfschool.edu>"

# ---- URLs ----
APP_URL=http://localhost
API_URL=http://localhost/api

# ---- Frontend (Vite) ----
# Only needed for dev if backend is on a different host
# VITE_API_URL=http://localhost:3000/api
